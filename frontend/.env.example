# Copy this file to .env.local for local development.
#
# LOCAL DEVELOPMENT
# Point to the locally-running FastAPI server:
VITE_NEWTON_API_URL=http://localhost:8000
#
# VERCEL PRODUCTION
# Leave VITE_NEWTON_API_URL unset (or set to empty string "").
# The API serverless function is served from the same origin, so
# relative URLs (e.g. /health, /ask) work automatically.
# VITE_NEWTON_API_URL=
